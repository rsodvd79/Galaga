<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Galaga.Views"
        x:Class="Galaga.MainWindow"
        Title="Galaga"
        Icon="avares://Galaga/Assets/icon.ico"
        Width="800" Height="600"
        MinWidth="400" MinHeight="300"
        Background="Black">
    <Viewbox Stretch="Uniform">
        <views:GameCanvas x:Name="Game" Width="800" Height="600" />
    </Viewbox>
</Window>
